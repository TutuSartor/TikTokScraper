# Copie para .env e ajuste os valores. Nunca versione o .env.

# --- PostgreSQL (credenciais separadas usadas pelo banco e pela API) ---
POSTGRES_USER=pi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=product_intelligence

# --- Aplicação ---
# Dentro do Compose o host é "db". Fora do Docker, localhost é o padrão.
# DATABASE_URL é uma alternativa para desenvolvimento local e tem prioridade se definida.
# Senhas com $, # ou espaços devem estar entre aspas simples no .env.

APP_ENV=development
LOG_LEVEL=INFO

# Porta publicada no host. A API fica presa a 127.0.0.1 por padrão (ver compose.yaml).
API_PORT=8000
